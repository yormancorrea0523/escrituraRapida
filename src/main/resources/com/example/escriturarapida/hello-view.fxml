<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="700.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.escriturarapida.HelloController">
   <children>
      <Label style="-fx-font-size: 26; -fx-font-weight: bold;" text="ESCRITURA RAPIDA" />
      <Label fx:id="nivelLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Nivel: 1" />
      <Label fx:id="tiempoLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Tiempo: 20s">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </Label>
      <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Debes escribir la Palabra:" />
      <Label fx:id="estadoLabel" style="-fx-font-size: 22; -fx-font-weight: bold;" />
      <Label fx:id="palabraLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Pulsa COMENZAR para Jugar" />
      <TextField fx:id="respuestaField" alignment="CENTER" onAction="#validarRespuesta" promptText="Escribe aquí la palabra:" style="-fx-font-size: 20;" />
      <Label style="-fx-font-size: 12;" text="Presiona ENTER para validar ↵" />
      <Button mnemonicParsing="false" onAction="#comenzarJuego" text="COMENZAR" />
      <Button mnemonicParsing="false" onAction="#reiniciarJuego" text="REINICIAR" />
   </children>
</VBox>
