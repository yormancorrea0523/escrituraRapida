<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" spacing="18.0" style="-fx-background-color: #111216; -fx-padding: 25; -fx-spacing: 18;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.escriturarapida.HelloController">
   <children>
      <Label style="-fx-font-size: 26; -fx-font-weight: bold;" text="ESCRITURA RAPIDA" />
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="50.0" style="-fx-background-color: #111216; -fx-padding: 12; -fx-background-radius: 12;">
         <children>
            <Label fx:id="nivelLabel" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #FFAD85;" text="Nivel: 1" />
            <Label fx:id="tiempoLabel" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #FFAD85;" text="Tiempo: 20s">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </Label>
         </children>
      </HBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="780.0" spacing="20.0" style="-fx-background-color: #1D1F25; -fx-padding: 30; -fx-background-radius: 16;">
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Debes escribir la Palabra:" />
            <Label fx:id="palabraLabel" style="-fx-font-size: 30; -fx-background-color: #1D1F25; -fx-font-weight: bold; -fx-text-fill: #FFAD85; -fx-padding: 20; -fx-background-radius: 12;" text="Pulsa COMENZAR para Jugar" />
            <Label style="-fx-font-size: 12;" text="Presiona ENTER para validar ↵" />
            <TextField fx:id="respuestaField" alignment="CENTER" onAction="#validarRespuesta" promptText="Escribe aquí la palabra:" style="-fx-font-size: 18; -fx-background-color: #1D1F25; -fx-background-radius: 10; -fx-border-color: #343640; -fx-border-radius: 10;" />
            <Label fx:id="estadoLabel" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #A8E6CF;" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#comenzarJuego" style="-fx-background-color: #E31837; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14 28 14 28; -fx-cursor: hand;" text="COMENZAR" />
                  <Button mnemonicParsing="false" onAction="#reiniciarJuego" style="-fx-background-color: #292B33; -fx-text-fill: #F5F5F7; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14 28 14 28; -fx-border-color: #41434D; -fx-border-radius: 10;" text="REINICIAR">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
